# Allow only build inputs. Local plans, credentials and test reports never enter
# the context, even when they live next to the source checkout.
**

!go.mod
!go.sum
!api/
!api/**/
!api/**/*.go
!cmd/
!cmd/**/
!cmd/**/*.go
!internal/
!internal/**/
!internal/**/*.go
!internal/gateway/schema.sql
**/*_test.go

# Isolated acceptance fixtures; credentials remain outside the build context.
!test/
!test/e2e/
!test/e2e/provider.js
!test/e2e/executor.js
!test/e2e/repository.js

# Explicit exclusions protect these if the allowlist is expanded later.
.private/
.git/
.agents/
.codex/
.env
.env.*
**/.env
**/.env.*
bin/
dist/
*.kubeconfig
**/*.key
**/*.pem
