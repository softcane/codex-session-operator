apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: my-go-postgres
  namespace: ${NAMESPACE}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: ${STORAGE_CLASS}
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-go-postgres
  namespace: ${NAMESPACE}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: my-go-postgres
  template:
    metadata:
      labels:
        app: my-go-postgres
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 70
        runAsGroup: 70
        fsGroup: 70
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: postgres
        image: postgres:18.3-alpine@sha256:54451ecb8ab38c24c3ec123f2fd501303a3a1856a5c66e98cecf2460d5e1e9d7
        args:
        - -c
        - ssl=on
        - -c
        - ssl_cert_file=/tls/tls.crt
        - -c
        - ssl_key_file=/tls/tls.key
        - -c
        - fsync=on
        - -c
        - full_page_writes=on
        - -c
        - synchronous_commit=on
        env:
        - name: POSTGRES_USER
          value: codex
        - name: POSTGRES_DB
          value: codex
        - name: POSTGRES_INITDB_ARGS
          value: --auth-host=scram-sha-256
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: my-go-postgres
              key: password
        - name: PGDATA
          value: /var/lib/postgresql/data
        readinessProbe:
          exec:
            command: [pg_isready, -h, 127.0.0.1, -U, codex, -d, codex]
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
        volumeMounts:
        - name: data
          mountPath: /var/lib/postgresql
        - name: socket
          mountPath: /var/run/postgresql
        - name: tls
          mountPath: /tls
          readOnly: true
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: my-go-postgres
      - name: socket
        emptyDir: {}
      - name: tls
        secret:
          secretName: my-go-postgres-tls
          defaultMode: 0640
---
apiVersion: v1
kind: Service
metadata:
  name: my-go-postgres
  namespace: ${NAMESPACE}
spec:
  selector:
    app: my-go-postgres
  ports:
  - port: 5432
    targetPort: 5432
