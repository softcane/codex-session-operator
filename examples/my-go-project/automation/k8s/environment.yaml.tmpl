apiVersion: agents.softcane.io/v1alpha1
kind: Environment
metadata:
  name: my-go-development
  namespace: ${NAMESPACE}
spec:
  mode: SelfHosted
  deletionPolicy: Delete
  selfHosted:
    sandboxPoolRef:
      name: my-go-project-v1
    capabilityDirectories:
    - /capabilities/my-go-project
    workspace:
      directory: /workspace
      deletionPolicy: Retain
